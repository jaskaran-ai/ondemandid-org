# Environment Variables Example
# Copy this file to .env and fill in the actual values

# Application
NEXT_PUBLIC_APP_NAME=Your App Name
# Production: https://register.ondemandid.com — Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://register.ondemandid.com

# CAPTCHA Provider Selection
# Set to 'turnstile' (default) or 'recaptcha'
CAPTCHA_PROVIDER=turnstile
NEXT_PUBLIC_CAPTCHA_PROVIDER=turnstile

# Cloudflare Turnstile (when CAPTCHA_PROVIDER=turnstile)
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google reCAPTCHA v2 Checkbox (when CAPTCHA_PROVIDER=recaptcha)
# Get keys at https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Demo Mode
# Set to 'true' to use simulated iVALT responses (for development/testing)
# Set to 'false' or remove to use real iVALT API integration
DEMO_MODE=true

# Database Configuration
# DB_TYPE: postgres (Supabase) for production, sqlite for local-only dev
DB_TYPE=sqlite

# Supabase PostgreSQL — required when DB_TYPE=postgres
# Use the Transaction pooler URI (port 6543) from Supabase: Project Settings → Database → Connection string → URI
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# ⚠ Keep secret — server-side / drizzle-kit only. Never expose to the client.
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# SQLite - Required if DB_TYPE=sqlite (default: ./local.db)
SQLITE_DB_PATH=./local.db

# iVALT API Configuration
# iVALT HTTP client timeout (ms) and minimum interval between status polls per request
IVALT_FETCH_TIMEOUT_MS=15000
IVALT_POLL_MIN_INTERVAL_MS=2500

# Required for production mode (DEMO_MODE=false)
IVALT_API_KEY=your_ivalt_api_key_here
IVALT_API_BASE_URL=https://api.ivalt.com

# Email Configuration
EMAIL_FROM=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
EMAIL_PROVIDER=ses  # 'ses' for AWS SES or 'smtp' for SMTP

# AWS SES Configuration (if EMAIL_PROVIDER=ses)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# SMTP Configuration (if EMAIL_PROVIDER=smtp or as fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=true

# Health Check Configuration
# Token for accessing detailed health endpoint
HEALTH_TOKEN=your-secret-health-token-here

# Upstash Redis (for production rate limiting and session storage)
UPSTASH_REDIS_REST_URL=your-redis-url
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Admin Panel Configuration
# Comma-separated allowlist for admin biometric login: +<country>:<mobile>
AUTHORIZED_ADMIN_NUMBERS=+91:9530654704,+91:6283974746
# The iVALT idConnection for the admin account (used for biometric admin login)
ADMIN_IVALT_ID_CONNECTION=IVALTADMIN
# Secret key for signing admin session tokens (use a strong random string in production)
ADMIN_SESSION_SECRET=your-strong-random-secret-key-here
